# ─── Docker Compose Environment ─────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tmadating

# ─── Telegram Bot ───────────────────────────────────────────
BOT_TOKEN=

# ─── JWT Secret (min 32 characters) ────────────────────────
JWT_SECRET=
